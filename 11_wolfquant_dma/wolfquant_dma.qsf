set_global_assignment -name SDC_FILE qsfp_mqnic.sdc
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION ON

# Expose the Corundum application DMA port on BAR2.
set_parameter -name APP_ID "32'h12348001"
set_parameter -name APP_ENABLE 1
set_global_assignment -name SEED 2
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
